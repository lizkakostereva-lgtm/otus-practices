# Rendered by ansible/deploy_airflow.yml -> /opt/mlops/docker-compose.yml
# Full-variant airflow VM: webserver + scheduler (LocalExecutor).
# The metadata DB is the dedicated postgres VM, MLflow lives on its own VM.

x-airflow-common: &airflow-common
  image: "{{ airflow_image }}:2.9.3"
  restart: unless-stopped
  environment: &airflow-env
    AIRFLOW__CORE__EXECUTOR: LocalExecutor
    AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: "postgresql+psycopg2://airflow:{{ postgres_password }}@{{ pg_host }}:5432/airflow"
    AIRFLOW__CORE__LOAD_EXAMPLES: "false"
    AIRFLOW__WEBSERVER__EXPOSE_CONFIG: "true"
    AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL: "30"
    MLFLOW_TRACKING_URI: "{{ mlflow_uri }}"
    MLFLOW_S3_ENDPOINT_URL: "{{ s3_endpoint_url }}"
    S3_ENDPOINT_URL: "{{ s3_endpoint_url }}"
    S3_DATA_BUCKET: "{{ bucket_data }}"
    S3_RAW_KEY: "{{ s3_raw_key }}"
    S3_DAGS_BUCKET: "{{ bucket_dags }}"
    AWS_ACCESS_KEY_ID: "{{ s3_access_key }}"
    AWS_SECRET_ACCESS_KEY: "{{ s3_secret_key }}"
    PYTHONPATH: "/opt/airflow/dags/repo"
  volumes:
    # DAGs are discovered under /opt/airflow/dags, the repo itself is exposed
    # at /opt/airflow/dags/repo so BashOperator tasks can run src/scripts.
    - /opt/mlops/repo/airflow/dags:/opt/airflow/dags
    - /opt/mlops/repo:/opt/airflow/dags/repo

services:
  airflow-init:
    <<: *airflow-common
    restart: "no"
    entrypoint: /bin/bash
    command:
      - -c
      - |
        airflow db migrate
        airflow users create \
          --username "{{ airflow_admin_user }}" \
          --password "{{ airflow_admin_password }}" \
          --firstname Admin --lastname Admin \
          --role Admin --email admin@example.com || true

  airflow-webserver:
    <<: *airflow-common
    command: airflow webserver
    ports:
      - "8080:8080"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 15s
      retries: 30

  airflow-scheduler:
    <<: *airflow-common
    command: airflow scheduler
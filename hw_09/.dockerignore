# Keep the build context small and secrets out of the image.
.git
.github
.gitignore
.dockerignore

# Python caches / local envs
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Tests are not needed at runtime (CI runs them before the build)
tests/

# Infrastructure and docs are not part of the runtime image
k8s/
terraform/
scripts/
docs/
data/
*.md

# Local-only artefacts
Makefile
docker-compose.yml
docker-compose.*.yml